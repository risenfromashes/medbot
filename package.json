{
  "name": "medbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A deterministic Telegram bot that nags you to take your medicines.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply MEDBOT_DB --remote && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply MEDBOT_DB --local",
    "migrate:remote": "wrangler d1 migrations apply MEDBOT_DB --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "simulate": "vitest run test/scenarios/transcript.test.ts --reporter=basic",
    "setup": "node scripts/medbot.mjs setup",
    "status": "node scripts/medbot.mjs status",
    "reset-password": "node scripts/medbot.mjs reset-password",
    "calibrate": "node scripts/medbot.mjs calibrate",
    "redeploy": "node scripts/medbot.mjs deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/risenfromashes/medbot.git"
  },
  "license": "MIT"
}
